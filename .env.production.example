# Copy to .env.production on the VM. Never commit the populated file.
POSTGRES_DB=assureai
POSTGRES_USER=assureai
POSTGRES_PASSWORD=replace-with-a-long-random-value
REDIS_PASSWORD=replace-with-a-different-long-random-value
ASSUREAI_PUBLIC_ORIGIN=http://your-hostname-or-ip
# The deterministic provider is appropriate for the public demo.
ASSUREAI_AI_PROVIDER=development
# To use OpenAI instead, set openai above and provide a backend-only key.
ASSUREAI_OPENAI_API_KEY=
ASSUREAI_OPENAI_MODEL=gpt-4o-mini
ASSUREAI_EMBEDDING_PROVIDER=development
ASSUREAI_EMBEDDING_MODEL=deterministic-development-v1
ASSUREAI_EMBEDDING_DIMENSIONS=64
ASSUREAI_EMBEDDING_BATCH_SIZE=32
ASSUREAI_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

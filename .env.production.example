# Copy to .env.production on the VM. Never commit the populated file.
POSTGRES_DB=assureai
POSTGRES_USER=assureai
POSTGRES_PASSWORD=replace-with-a-long-random-value
REDIS_PASSWORD=replace-with-a-different-long-random-value
ASSUREAI_PUBLIC_ORIGIN=http://your-hostname-or-ip
# Demo-only auth adapter. Use oidc with issuer/audience/JWKS for production identity.
ASSUREAI_AUTH_MODE=development
ASSUREAI_SESSION_SECRET=replace-with-at-least-32-random-bytes
ASSUREAI_SECURE_COOKIES=false
ASSUREAI_OIDC_ISSUER=
ASSUREAI_OIDC_AUDIENCE=
ASSUREAI_OIDC_JWKS_URL=
ASSUREAI_HTTPS_ENABLED=false
ASSUREAI_STORAGE_PROVIDER=local
ASSUREAI_AZURE_STORAGE_ACCOUNT_URL=
ASSUREAI_AZURE_STORAGE_CONTAINER=documents
ASSUREAI_SECRET_STORE_PROVIDER=environment
ASSUREAI_KEY_VAULT_URL=
ASSUREAI_MALWARE_SCANNER=disabled
ASSUREAI_CLAMAV_HOST=clamav
ASSUREAI_CLAMAV_PORT=3310
ASSUREAI_METRICS_TOKEN=replace-with-a-different-random-token
ASSUREAI_OTEL_EXPORTER_OTLP_ENDPOINT=
# The deterministic provider is appropriate for the public demo.
ASSUREAI_AI_PROVIDER=development
# To use OpenAI instead, set openai above and provide a backend-only key.
ASSUREAI_OPENAI_API_KEY=
# With Key Vault, prefer a secret name here and leave the direct key empty.
ASSUREAI_OPENAI_API_KEY_REF=
ASSUREAI_OPENAI_MODEL=gpt-4o-mini
ASSUREAI_EMBEDDING_PROVIDER=development
ASSUREAI_EMBEDDING_MODEL=deterministic-development-v1
ASSUREAI_EMBEDDING_DIMENSIONS=64
ASSUREAI_EMBEDDING_BATCH_SIZE=32
ASSUREAI_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ASSUREAI_EVALUATION_MAX_CASES=200

# Copy to .env for local development. Do not commit .env.
ASSUREAI_ENVIRONMENT=development
ASSUREAI_LOG_LEVEL=INFO
ASSUREAI_CORS_ORIGINS=["http://localhost:5173"]

POSTGRES_DB=assureai
POSTGRES_USER=assureai
POSTGRES_PASSWORD=change-me-for-non-local-use
ASSUREAI_DATABASE_URL=postgresql+psycopg://assureai:change-me-for-non-local-use@postgres:5432/assureai
ASSUREAI_REDIS_URL=redis://redis:6379/0

# Planned provider configuration. Keep real keys only in an untracked .env or secret manager.
ASSUREAI_AI_PROVIDER=disabled
OPENAI_API_KEY=

VITE_API_BASE_URL=http://localhost:8000

# Copy to .env for local development. Do not commit .env.
ASSUREAI_ENVIRONMENT=development
ASSUREAI_LOG_LEVEL=INFO
ASSUREAI_CORS_ORIGINS=["http://localhost:5173"]

POSTGRES_DB=assureai
POSTGRES_USER=assureai
POSTGRES_PASSWORD=change-me-for-non-local-use
ASSUREAI_DATABASE_URL=postgresql+psycopg://assureai:change-me-for-non-local-use@postgres:5432/assureai
ASSUREAI_REDIS_URL=redis://redis:6379/0
ASSUREAI_STORAGE_PATH=/data/documents
ASSUREAI_MAX_UPLOAD_BYTES=20971520

# Development is deterministic and offline. Use openai only with a backend secret.
ASSUREAI_AI_PROVIDER=development
ASSUREAI_OPENAI_API_KEY=
ASSUREAI_OPENAI_MODEL=gpt-4o-mini
ASSUREAI_EMBEDDING_PROVIDER=development
ASSUREAI_EMBEDDING_MODEL=deterministic-development-v1
ASSUREAI_EMBEDDING_DIMENSIONS=64
ASSUREAI_EMBEDDING_BATCH_SIZE=32
ASSUREAI_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

VITE_API_BASE_URL=http://localhost:8000
